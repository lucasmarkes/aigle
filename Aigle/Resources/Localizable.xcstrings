    "Aigle couldn’t get permission to open that folder.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aigle n’a pas obtenu l’autorisation d’ouvrir ce dossier."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aigle hat keine Berechtigung erhalten, diesen Ordner zu öffnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aigle no obtuvo permiso para abrir esa carpeta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aigle non ha ottenuto il permesso di aprire quella cartella."
