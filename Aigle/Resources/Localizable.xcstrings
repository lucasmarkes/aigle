    "A calm home for the images, videos and links you collect.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un endroit paisible pour les images, vidéos et liens que vous collectionnez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein ruhiger Ort für die Bilder, Videos und Links, die Sie sammeln."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un hogar tranquilo para las imágenes, vídeos y enlaces que coleccionas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una casa tranquilla per immagini, video e link che raccogli."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Спокійний дім для зображень, відео та посилань, які ви збираєте."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "为你收集的图片、视频和链接准备的安静归处。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "集めた画像・動画・リンクの静かな置き場所。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Um lar tranquilo para as imagens, vídeos e links que você coleciona."
          }
        }
      }
    },
