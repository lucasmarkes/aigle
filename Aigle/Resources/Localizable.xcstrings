    "Aigle searches your library and every connected folder.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aigle cherche dans votre bibliothèque et dans chaque dossier connecté."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aigle durchsucht Ihre Mediathek und jeden verbundenen Ordner."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aigle busca en tu biblioteca y en cada carpeta conectada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aigle cerca nella libreria e in ogni cartella collegata."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aigle шукає у вашій бібліотеці та в кожній під’єднаній теці."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aigle 会搜索你的库和每个已连接的文件夹。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aigle はライブラリと接続済みフォルダをすべて検索します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Aigle busca na sua biblioteca e em cada pasta conectada."
          }
        }
      }
    },
