    "Your library is a plain folder on disk. Nothing is uploaded anywhere.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Votre bibliothèque est un simple dossier sur le disque. Rien n’est envoyé nulle part."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ihre Mediathek ist ein einfacher Ordner auf der Festplatte. Nichts wird irgendwohin geladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tu biblioteca es una carpeta normal en el disco. No se sube nada a ninguna parte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La tua libreria è una semplice cartella su disco. Nulla viene caricato altrove."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ваша бібліотека — звичайна тека на диску. Нічого нікуди не надсилається."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "你的库就是磁盘上的一个普通文件夹，不会上传到任何地方。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ライブラリはディスク上の普通のフォルダです。どこにもアップロードされません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sua biblioteca é uma pasta comum no disco. Nada é enviado para lugar algum."
          }
        }
      }
